# ── GitHub ────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ── HuggingFace ───────────────────────────────────────────
HF_TOKEN=hf_your_token_here
HF_MODEL_NAME=codellama/CodeLlama-7b-hf

# ── Model ─────────────────────────────────────────────────
MODEL_PATH=./models/codellama-review-lora
USE_4BIT=false
DEVICE=cpu

# ── Server ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ── Inference ─────────────────────────────────────────────
MAX_NEW_TOKENS=512
TEMPERATURE=0.1
TOP_P=0.9
CONFIDENCE_THRESHOLD=0.6

# ── Weights & Biases ──────────────────────────────────────
WANDB_PROJECT=llm-code-review
WANDB_API_KEY=your_wandb_key_here